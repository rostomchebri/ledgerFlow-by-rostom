// LedgerFlow database schema.
//
// The User / Session / Account / Verification / RateLimit models are the
// tables Better Auth expects. Keep the field names in sync with the auth
// configuration in src/lib/auth.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for application traffic on Neon.
  url       = env("DATABASE_URL")
  // Direct connection for migrations, introspection and other session-scoped
  // operations. On Neon this is DATABASE_URL_UNPOOLED; locally it can match
  // DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  emailVerified       Boolean        @default(false)
  image               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sessions            Session[]
  accounts            Account[]
  memberships         FirmMember[]
  invitationsSent     Invitation[]   @relation("InvitationInvitedBy")
  invitationsAccepted Invitation[]   @relation("InvitationAcceptedBy")
  assignedClients     Client[]       @relation("ClientAssignee")
  tasksAssigned       Task[]         @relation("TaskAssignee")
  tasksCreated        Task[]         @relation("TaskCreator")
  taskComments        TaskComment[]
  documentsUploaded   Document[]     @relation("DocumentUploader")
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Better Auth's database-backed rate limiter (rateLimit.storage = "database").
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int    @default(0)
  lastRequest BigInt

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// CLIENT — client management (CLIENT-01/02/03)
// Minimal tenant root so client queries can always be scoped by `firmId`
// (FIRM-05). FIRM-01 owns the full workspace lifecycle.
// ---------------------------------------------------------------------------

model Firm {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients       Client[]
  members       FirmMember[]
  invitations   Invitation[]
  transactions  Transaction[]
  invoices      Invoice[]
  documents     Document[]
  tasks         Task[]
  taskTemplates TaskTemplate[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("firms")
}

/// FIRM-02 — a user belongs to a firm with exactly one role.
/// The role drives the permission policy in src/lib/rbac.ts.
enum FirmRole {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

/// FIRM-01 / FIRM-02 — explicit membership replaces the demo firm context.
/// A user may belong to several firms; queries are always scoped by firmId.
model FirmMember {
  id        String   @id @default(cuid())
  firmId    String
  userId    String
  role      FirmRole @default(ACCOUNTANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([firmId, userId])
  @@index([userId])
  @@map("firm_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// FIRM-03 — e-mail invitations to join a firm.
/// The raw token is stored hashed? For MVP we store an opaque random token.
model Invitation {
  id           String           @id @default(cuid())
  firmId       String
  email        String
  role         FirmRole         @default(ACCOUNTANT)
  status       InvitationStatus @default(PENDING)
  token        String           @unique
  expiresAt    DateTime
  invitedById  String?
  acceptedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  firm       Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invitedBy  User? @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([firmId, status])
  @@index([email, status])
  @@map("invitations")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

/// A client (individual or company) belonging to exactly one firm.
/// Tax identifiers are stored as free-form, configurable data — no tax rules are inferred.
model Client {
  id        String  @id @default(cuid())
  firmId    String
  reference String?

  type        ClientType   @default(COMPANY)
  status      ClientStatus @default(ACTIVE)
  name        String
  contactName String?

  email String?
  phone String?

  /// Tax identification number (e.g. NIF). Free-form; never validated against legal rules.
  taxId              String?
  /// Commercial register number (e.g. RC). Free-form.
  commercialRegister String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  country      String  @default("DZ")

  notes String?

  archivedAt   DateTime?
  createdById  String?
  assignedToId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  firm         Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("ClientAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  invoices     Invoice[]
  documents    Document[]
  tasks        Task[]

  @@unique([firmId, reference])
  @@index([firmId, status])
  @@index([firmId, name])
  @@index([firmId, updatedAt])
  @@index([firmId, assignedToId])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// FINANCE — transactions, invoices and the dashboard aggregates built on them.
// Amounts are stored as Decimal so currency arithmetic never relies on floats.
// ---------------------------------------------------------------------------

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  CLEARED
  PENDING
}

enum TransactionCategory {
  SALES
  SERVICES
  OPERATIONS
  MARKETING
  SOFTWARE
  PAYROLL
  OTHER
}

/// One money movement for a firm. `clientId` is optional because some expenses
/// (software subscriptions, rent) are not attributable to a client.
model Transaction {
  id          String              @id @default(cuid())
  firmId      String
  clientId    String?
  type        TransactionType
  status      TransactionStatus   @default(CLEARED)
  category    TransactionCategory
  reference   String?
  description String
  amount      Decimal             @db.Decimal(14, 2)
  currency    String              @default("DZD")
  occurredAt  DateTime
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([firmId, occurredAt])
  @@index([firmId, type])
  @@index([firmId, clientId])
  @@map("transactions")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id          String        @id @default(cuid())
  firmId      String
  clientId    String
  number      String
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime
  dueDate     DateTime
  subtotal    Decimal       @db.Decimal(14, 2)
  total       Decimal       @db.Decimal(14, 2)
  currency    String        @default("DZD")
  notes       String?
  createdById String?
  sentAt      DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  firm      Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems InvoiceLine[]

  @@unique([firmId, number])
  @@index([firmId, status])
  @@index([firmId, issueDate])
  @@index([firmId, clientId])
  @@map("invoices")
}

/// Invoice line items keep the invoice total reproducible and auditable.
model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  position    Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ---------------------------------------------------------------------------
// DOC — document library, categories and tags.
// ---------------------------------------------------------------------------

enum DocumentCategory {
  CONTRACT
  INVOICE
  RECEIPT
  TAX
  IDENTITY
  BANK
  OTHER
}

model Document {
  id               String           @id @default(cuid())
  firmId           String
  clientId         String?
  uploadedById     String?
  name             String
  /**
   * Original upload filename, used to preserve the name and extension on download.
   */
  originalFilename String?
  description      String?
  category         DocumentCategory @default(OTHER)
  tags             String[]         @default([])
  mimeType         String
  size             Int
  storageKey       String           @unique
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  firm       Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  uploadedBy User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([firmId, deletedAt])
  @@index([firmId, clientId])
  @@index([firmId, category])
  @@index([firmId, createdAt])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// TASK — tasks, deadlines, templates, comments and checklists.
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Task {
  id          String         @id @default(cuid())
  firmId      String
  clientId    String?
  title       String
  description String?
  status      TaskStatus     @default(TODO)
  priority    TaskPriority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String?
  createdById String?
  recurrence  TaskRecurrence @default(NONE)
  templateId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  firm      Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client    Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee  User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  template  TaskTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  comments  TaskComment[]
  checklist ChecklistItem[]

  @@index([firmId, status])
  @@index([firmId, dueDate])
  @@index([firmId, clientId])
  @@index([firmId, assigneeId])
  @@map("tasks")
}

model TaskTemplate {
  id                   String         @id @default(cuid())
  firmId               String
  name                 String
  title                String
  description          String?
  priority             TaskPriority   @default(MEDIUM)
  recurrence           TaskRecurrence @default(NONE)
  defaultDueOffsetDays Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  firm  Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([firmId])
  @@map("task_templates")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  label     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("checklist_items")
}

// ---------------------------------------------------------------------------
// NOTIF — in-app notification center and e-mail reminders.
// ---------------------------------------------------------------------------

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  INVOICE_OVERDUE
  INVITATION
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  firmId    String
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([firmId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// AUDIT — append-only activity log.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  firmId     String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  firm  Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([firmId, createdAt])
  @@index([firmId, entityType, entityId])
  @@index([firmId, action])
  @@map("audit_logs")
}
