# OPS-01 — production environment template.
# Copy to `.env.production` on the server, fill every value, never commit it.
# Generate secrets with: openssl rand -base64 32
#
# DATABASE_URL points at the compose service name (`postgres`), not localhost.
# POSTGRES_PASSWORD and the password inside DATABASE_URL must match.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.example.com
BETTER_AUTH_URL=https://app.example.com
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# Extra trusted origins (comma-separated), for example a second domain, a
# staging host, or an IP-based URL. Keep this list as small as possible.
BETTER_AUTH_TRUSTED_ORIGINS=

POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=ledgerflow
DATABASE_URL=postgresql://ledgerflow:replace-with-a-strong-database-password@postgres:5432/ledgerflow?schema=public
# Direct (non-pooled) connection for migrations and the jobs worker.
# On Neon, `neon deploy` writes this as DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=postgresql://ledgerflow:replace-with-a-strong-database-password@postgres:5432/ledgerflow?schema=public

JOBS_SCHEMA=pgboss
REMINDER_CRON=0 6 * * *
REMINDER_TIMEZONE=Africa/Algiers

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ledgerflow
S3_ACCESS_KEY_ID=replace-with-a-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-storage-secret-key
S3_FORCE_PATH_STYLE=true
# Neon Object Storage alternative: omit the S3_* credentials above and set the
# AWS_* variables that `neon deploy` pulls into .env instead. S3_BUCKET stays
# required (for example `documents`).
# AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=replace-with-a-storage-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-a-storage-secret-key

# Email delivery — configure Resend, SMTP, or both.
# `auto` prefers Resend when a key is present and falls back to SMTP.
# The From address must be a verified sender/domain for the chosen provider.
EMAIL_PROVIDER=auto
EMAIL_FROM="LedgerFlow <no-reply@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
