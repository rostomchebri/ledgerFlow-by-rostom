# ---------------------------------------------------------------------------
# LedgerFlow — example environment variables.
# Copy to .env and fill in local values. Never commit real secrets.
# Typed validation lives in src/lib/env.ts.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (matches docker/compose.dev.yml)
DATABASE_URL=postgresql://ledgerflow:ledgerflow@localhost:5432/ledgerflow?schema=public
# Direct (non-pooled) connection used by Prisma migrations and the jobs worker.
# Local Docker has no pooler, so this can match DATABASE_URL.
# On Neon, `neon deploy` writes the real value as DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=postgresql://ledgerflow:ledgerflow@localhost:5432/ledgerflow?schema=public

# Auth (Better Auth) — generate with: openssl rand -base64 32
# Must be at least 32 characters. The value below is a local-only placeholder.
BETTER_AUTH_SECRET=ledgerflow-local-dev-secret-change-me-please
BETTER_AUTH_URL=http://localhost:3000
# Extra trusted origins (comma-separated). Development already trusts every
# localhost/127.0.0.1/[::1] port; add LAN or tunnel URLs here when needed.
BETTER_AUTH_TRUSTED_ORIGINS=

# Auth hardening
# Rate limiting is enabled by default (database-backed, survives restarts).
AUTH_RATE_LIMIT_ENABLED=true
# Session lifetime in days. Sessions are refreshed once per day.
AUTH_SESSION_EXPIRES_IN_DAYS=7

# Development seed account (pnpm db:seed). Change before sharing a database.
DEMO_USER_EMAIL=demo@ledgerflow.local
DEMO_USER_PASSWORD=LedgerFlowDemo123

# Object storage (S3-compatible / MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ledgerflow-dev
S3_ACCESS_KEY_ID=ledgerflow
S3_SECRET_ACCESS_KEY=ledgerflow-secret
S3_FORCE_PATH_STYLE=true
# Neon Object Storage injects the standard AWS_* names instead. The app accepts
# either set, but S3_BUCKET is always required. Keep these commented locally.
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email delivery
# `auto` uses Resend when RESEND_API_KEY is set, otherwise SMTP.
# - Resend: set RESEND_API_KEY and a verified EMAIL_FROM sender/domain.
# - SMTP: set SMTP_* (Mailpit locally on port 1025, or a real relay in production).
# - If neither is configured, development prints the message to the terminal.
EMAIL_PROVIDER=auto
EMAIL_FROM="LedgerFlow <no-reply@ledgerflow.local>"
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Kept as a fallback for deployments that only configure SMTP_FROM.
SMTP_FROM="LedgerFlow <no-reply@ledgerflow.local>"

# Background jobs (pg-boss reuses DATABASE_URL)
JOBS_SCHEMA=pgboss
# NOTIF-03 — daily reminder sweep (cron + IANA timezone). Configure per deployment.
REMINDER_CRON=0 6 * * *
REMINDER_TIMEZONE=Africa/Algiers
